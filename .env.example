# OpenRouter API key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: choose which model OpenSeal uses via OpenRouter.
# Defaults to openrouter/anthropic/claude-haiku-4.5 if unset.
# Any OpenRouter model works, e.g.:
#   openrouter/openai/gpt-4o-mini
#   openrouter/meta-llama/llama-3.3-70b-instruct
#   openrouter/google/gemini-2.0-flash
OPENROUTER_MODEL=openrouter/anthropic/claude-haiku-4.5

# Optional chat channels (only required if you use them)
# TELEGRAM_BOT_TOKEN=...
# DISCORD_BOT_TOKEN=...
# DISCORD_PUBLIC_KEY=...
# DISCORD_APPLICATION_ID=...
